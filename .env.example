MONGODB_URI=your_mongodb_connection_string
PORT=3000

# Meta App Credentials (REQUIRED - app-level, one per vendor)
# Get these from developers.facebook.com > Your App > Settings > Basic.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CONFIG_ID=your_embedded_signup_config_id

# App-level webhook verify token. Any random string; must match what you enter in
# the Meta App Dashboard webhook configuration. No default - required.
WHATSAPP_VERIFY_TOKEN=your_random_verify_token

# NOTE: Per-merchant WhatsApp credentials (phone number id, WABA id, access token)
# are NOT configured here. Each merchant connects their own via Embedded Signup and
# their credentials are stored on their Merchant record. There is deliberately no
# shared WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID fallback: one shared number
# would make every merchant send from the same WhatsApp account.

# Shopify App Credentials (Required for OAuth)
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_checkouts,read_customers,read_fulfillments,read_orders,write_orders,read_billing,write_billing
SHOPIFY_APP_URL=https://api.yourdomain.com
FRONTEND_APP_URL=https://your-frontend.vercel.app/dashboard

# Billing Configuration
# Set to 'true' for test charges (development), remove or set to anything else for live charges
SHOPIFY_BILLING_TEST=false
